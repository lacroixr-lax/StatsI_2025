# remove objects
rm(list=ls())
# load libraries
pkgTest <- function(pkg){
new.pkg <- pkg[!(pkg %in% installed.packages()[,  "Package"])]
if (length(new.pkg))
install.packages(new.pkg,  dependencies = TRUE)
sapply(pkg,  require,  character.only = TRUE)
}
# set wd for current folder
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))
# read in data
inc.sub <- read.csv("https://raw.githubusercontent.com/ASDS-TCD/StatsI_2025/main/datasets/incumbents_subset.csv")
View(inc.sub)
# Question 1
# Regression
vote_diff <- lm(voteshare ~ difflog, data = inc.sub)
vote_diff
# here is where you load any necessary packages
# ex: stringr
# lapply(c("stringr"),  pkgTest)
lapply(c("readr", "ggplot2"),  pkgTest)
# Scatterplot
scatter1 <-
ggplot(inc.sub, aes(x = voteshare, y = difflog)) +
geom_point() +
geom_smooth(method='lm',col="black")
scatter1
