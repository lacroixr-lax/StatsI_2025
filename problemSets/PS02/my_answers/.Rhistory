calculate_t_statistic <- function(mat, grep) {
if (!is.matrix(mat)) {
stop()
}
if (!is.vector(grp)) {
stop()
}
for (i in 1:ncol(mat)) {
t_test <- apply(grp, mat = 2, t.test)
}
return(t_test)
}
calculate_t_statistic(mat, grp)
calculate_t_statistic <- function(mat, grep) {
if (!is.matrix(mat)) {
stop()
}
if (!is.vector(grp)) {
stop()
}
for (i in 1:ncol(mat)) {
t_test <- apply(grp, mat = 2, FUN = t.test)
}
return(t_test)
}
