if (i == num_vec[1]) {
fib_num[i] <- 0
} else if (i == num_vec[2]) {
fib_num[i] <- 1
} else if (i > 1) {
fib_num[i] <- num_vec[i-1]+num_vec[i-2]
}
}
fib_num
}
