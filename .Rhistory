library(stargazer)
output_stargazer <- function(outputFile, ...) {
output <- capture.output(stargazer(...))
cat(paste(output, collapse = "\n"), "\n", file = outputFile, append = TRUE)
}
output_stargazer("hyp_test_table.tex", hyp_test)
